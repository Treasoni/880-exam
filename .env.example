# 880 考研数学习题系统 · 本地环境变量模板
# 复制为 .env 使用;真实值只写本地 .env,不要提交本文件之外的环境配置。

# === Project Identity ===
APP_NAME=880-exam
APP_ENV=development

# === Workspace Paths ===
# 880 脚本当前使用基于仓库根的固定相对路径(见 scripts/lib880.py),
# 此处为约定的工作区布局,后续需要可配置路径时在此扩展。
WORKSPACE_PATH=./workspace
WORKFLOW_RUNS_PATH=${WORKSPACE_PATH}/workflow-runs

# === Runtime Behavior ===
LOG_LEVEL=info
DEBUG=false

# Python 解释器(被 .claude/scripts/sync-workflow-routing.sh 等模板脚本读取)
PYTHON=python3
