{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '.claude/hooks/read_learnings.py'"
          },
          {
            "type": "command",
            "command": "python3 '.claude/scripts/collect_llm_usage.py' --quiet"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '.claude/scripts/collect_llm_usage.py' --quiet"
          }
        ]
      }
    ]
  }
}
